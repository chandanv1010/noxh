<VirtualHost *:80>
    DocumentRoot "C:/laragon/www/noxh/public"
    ServerName noxh.test
    ServerAlias *.noxh.test
    <Directory "C:/laragon/www/noxh/public">
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>

# If you want to use SSL, enable it by going to Menu > Apache > SSL > Enabled
