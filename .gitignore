/vendor
/node_modules
.env
.env.backup

# Anh nguoi dung tai len qua admin. De tren may chu, khong dua vao git:
# hien dang la 21 MB anh cua ma nguon truoc, va anh moi se do vao day.
#
# RIENG public/uploads/noxh thi CO dua vao git: do khong phai anh nguoi dung
# tai len ma la anh cat ra tu cac ban thiet ke trong noxh_image/ bang lenh
# `python tools/tach-anh-ban-ve.py`. May chu that khong co Python lan ban ve
# nen khong chay lai duoc - thieu thu muc nay la ca bo kiem tra dieu kien,
# ba trang ket qua va anh tu van vien deu trong.
/public/uploads/*
!/public/uploads/noxh/
!/public/uploads/van-ban/
/public/upload
/public/userfiles/*
!/public/userfiles/.gitignore
# Ngoai le: anh co ngon ngu do `python tools/lam-anh-co.py` ve ra, KHONG phai
# anh nguoi dung tai len. Thieu thi moi trang quan tri 404 mot anh co, vi
# languages.image trong CSDL tro vao day. Phai mo lai thu muc cha thi git moi
# di vao duoc (mau trong public/userfiles/.gitignore cung phai mo).
!/public/userfiles/image/

# Anh resize tu sinh boi ImageResizerController - tu tao lai duoc. Giu lai
# chinh thu muc de ban sao moi co san cho ghi.
/public/image-cache/*
!/public/image-cache/.gitignore

/public/storage
/public/hot

# Cache va log tu sinh
/storage/*.key
/storage/debugbar
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing
/bootstrap/cache/*.php

# Ban xuat CSDL. De ngoai git: file nang vai MB, moi lan xuat lai la mot
# ban nhi phan moi lam phinh kho, va trong do co mat khau da bam cua tai
# khoan quan tri. Giu o thu muc rieng ngoai du an.
/db
*.sql

# Anh mo phong, ban nhap
/work
public.zip
*.zip

# Anh goc do phan giai cao (9,7 MB) de sinh banner trang chu. Tai lai duoc bang
# `powershell -File tools/tai-anh-goc.ps1` nen khong dua vao git cho phinh kho;
# chi giu tools/anh-goc/NGUON-ANH.txt ghi ro nguon va giay phep.
/tools/anh-goc/*.jpg

# Hash mat khau that cua tai khoan quan tri, chi de khoi phuc tam tren may nay.
/scratch/admin-password-backup.json

# Anh chup doi chieu khi kiem tra giao dien - nang, tao lai duoc bang
# `node scratch/chup-banner.cjs` hoac `node scratch/do-nut-hero.cjs`.
/scratch/anh-chup/

.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.idea
/.vscode
/.fleet
.DS_Store
Thumbs.db
